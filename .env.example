# Choose exactly one primary provider. MODEL_FALLBACK_ORDER is an optional comma-separated list.
MODEL_PROVIDER=openai
MODEL_FALLBACK_ORDER=

# Bedrock uses the standard AWS credential chain. Do not commit credentials.
AWS_REGION=us-east-1
DEFAULT_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Direct-provider credentials and model IDs (also used when configured as fallbacks).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5.4

MODEL_CONFIG_PATH=config/models.yaml

# Local mode uses a fixed identity and is only for single-user development.
# Production should use Cognito access tokens and configure the issuer as:
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
AUTH_MODE=development
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_REQUIRED_SCOPES=research:run
COGNITO_TENANT_CLAIM=custom:tenant_id
COGNITO_JWKS_CACHE_SECONDS=3600

# Leave empty for process-local persistence. The DynamoDB table requires PK/SK string keys and
# DynamoDB TTL enabled on the numeric expires_at attribute.
DYNAMODB_RUNS_TABLE=
SQS_JOBS_QUEUE_URL=
RUN_RETENTION_DAYS=30

# Live research adapters. The worker constructs these per authorized tenant/run.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
PLAYWRIGHT_HEADLESS=true

# Local OpenSearch. For Serverless, use HTTPS and set AWS region; service defaults to aoss.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=deep-research-upload-chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_AWS_REGION=
OPENSEARCH_AWS_SERVICE=aoss

# Private local artifacts and fail-closed ClamAV scanning.
# Leave false for public-web-only development; OpenSearch and ClamAV are then never constructed.
UPLOADS_ENABLED=false
UPLOAD_ARTIFACT_ROOT=.data/uploads
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
